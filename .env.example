# ==================================================================
# VARIABLES DE ENTORNO - AUDITOR DE EQUIPOS
# ==================================================================
# IMPORTANTE: Copia este archivo como .env.local y llena los valores
# NUNCA subas .env.local a Git (ya está en .gitignore)
# ==================================================================

# ==================================================================
# SUPABASE
# ==================================================================

# URL de tu proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://iabcqcjmdgvomkuhtmec.supabase.co

# Publishable Key (Anon Key) - Para el cliente
# 📍 Obtener en: https://app.supabase.com/project/iabcqcjmdgvomkuhtmec/settings/api
# Sección: "Project API keys" → "anon public"
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Key - Para operaciones de backend (CONFIDENCIAL)
# 📍 Obtener en: https://app.supabase.com/project/iabcqcjmdgvomkuhtmec/settings/api
# Sección: "Project API keys" → "service_role" (⚠️ NUNCA expongas esta key al cliente)
# IMPORTANTE: Esta key es necesaria para el MCP de Claude Code
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==================================================================
# GOOGLE DRIVE (Para almacenamiento de fotos)
# ==================================================================

# ID de la carpeta de Google Drive donde se subirán las fotos
# 📍 Obtener de: URL de carpeta compartida después de /folders/
# Ejemplo: https://drive.google.com/drive/folders/1a2b3c4d5e6f7g8h9i0j → usar 1a2b3c4d5e6f7g8h9i0j
GOOGLE_DRIVE_FOLDER_ID=

# Email de la Service Account de Google
# 📍 Obtener de: Google Cloud Console → IAM & Admin → Service Accounts
# Ejemplo: auditor-drive-uploader@proyecto.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Private Key de la Service Account (formato JSON completo)
# 📍 Obtener de: Archivo JSON descargado al crear la Service Account
# IMPORTANTE: Debe incluir los saltos de línea como \n
# Ejemplo: "-----BEGIN PRIVATE KEY-----\nMIIEvQIBA...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=

# ==================================================================
# GEMINI AI (Para procesamiento OCR posterior)
# ==================================================================

# API Key de Gemini
# 📍 Obtener en: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# ==================================================================
# INSTRUCCIONES PARA OBTENER LA SERVICE ROLE KEY DE SUPABASE
# ==================================================================
#
# PASO 1: Ve a tu proyecto en Supabase
#   https://app.supabase.com/project/iabcqcjmdgvomkuhtmec/settings/api
#
# PASO 2: En la sección "Project API keys", encontrarás DOS keys:
#   ✅ anon public (Publishable Key) - Para el frontend
#      Ejemplo: sb_publishable_YtKeA_Fi5bp81fuY4aQDPg_yCBlj8QL
#
#   ⚠️ service_role (Service Role Key) - Para el backend y MCP
#      Empieza con: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
#      Esta es la que necesitas para SUPABASE_SERVICE_ROLE_KEY
#
# PASO 3: Haz clic en "Reveal" junto a service_role
#
# PASO 4: Copia la key COMPLETA (es muy larga, ~300+ caracteres)
#
# PASO 5: Pégala en SUPABASE_SERVICE_ROLE_KEY arriba
#
# ==================================================================
